# Copiar este archivo como .env y completar los valores reales. El .env NO se versiona.
# Ninguna contraseña ni clave de firma tiene valor por defecto en el código.

# Base de datos (PostgreSQL 16+ con controlador asincrónico asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pool de conexiones y diagnóstico SQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQL_ECHO=true

# Autenticación y seguridad
# Generar una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_de_al_menos_32_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENT=4
