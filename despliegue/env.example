# Plantilla del archivo de variables del contenedor (docker run --env-file <archivo>).
# El archivo real vive en el servidor, fuera del repositorio y de la imagen: NO se versiona.
# También sirve como .env para correr el TP sin Docker (en ese caso el host es localhost).

# Formato: postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Dentro del contenedor, localhost es el propio contenedor y no el servidor:
# - base en el mismo VPS  -> host.docker.internal (y en docker run:
#                            --add-host=host.docker.internal:host-gateway)
# - base que da la cátedra -> la dirección que indique la cátedra
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@host.docker.internal:5432/libreria

# false: no escribe cada consulta SQL en el registro (en desarrollo, true).
SQL_ECHO=false
